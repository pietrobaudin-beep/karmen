# Karmen AI (opcional para dev — sem isso o app roda, mas o assistente/resumos ficam off)
ANTHROPIC_API_KEY=

# Transcrição de áudio / STT (opcional — sem isso gravar/importar funciona, mas não transcreve)
# Provedor padrão: OpenAI Whisper. Trocável em src/lib/transcribe.ts.
OPENAI_API_KEY=

# Banco de produção (Vercel/Supabase). Se definido, o app usa Postgres em vez do
# PGlite local. Use a "Connection string" do POOLER do Supabase (modo Transaction,
# porta 6543). Ex.: postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
# Em dev local, deixe VAZIO para usar o PGlite em memória.
DATABASE_URL=

# Snapshot do banco de dev (PGlite em memória). Padrão: ./.karmen-db.tar.gz
KARMEN_DB_FILE=./.karmen-db.tar.gz
